# Copy to .env and customize before starting Compose.
DISCRAKT_IMAGE=discrakt-sidecar:local
DISCRAKT_VERSION=docker-sidecar
DISCRAKT_UID=1000
DISCRAKT_GID=1000
DISCRAKT_BIND_ADDRESS=127.0.0.1
DISCRAKT_SETUP_PORT=18081
DISCRAKT_LOG_LEVEL=info

# compose.yaml: an existing volume already mounted by your Discord container.
DISCORD_IPC_VOLUME=discord-ipc

# compose.host.yaml: directory containing the native Linux Discord IPC socket.
# Confirm the actual location; /tmp is another common location.
DISCORD_IPC_DIR=/run/user/1000
